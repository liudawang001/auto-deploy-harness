{
  "runs_dir": "runs",
  "default_timeout_seconds": 900,
  "max_stage_attempts": 2,
  "max_repair_attempts": 2,
  "allow_source_edit": false,
  "allow_dependency_install": false,
  "allow_service_start": false,
  "execution_backend": "local",
  "deployment_capability_mode": "shadow",
  "deployment_contract_enabled": true,
  "deployment_adapter_registry_enabled": false,
  "protocol_verify_registry_enabled": false,
  "repository_command_policy": {
    "enabled": true,
    "unknown_repository_backend": "docker",
    "approval_mode": "risk_based",
    "approval_ttl_seconds": 1800,
    "max_runner_candidate_attempts": 3,
    "max_strategy_attempts": 2,
    "allow_make_targets": true,
    "allow_repository_scripts": true,
    "auto_allow_declared_project_cli_in_docker": true,
    "auto_allow_locked_package_scripts_in_docker": true,
    "require_readme_reference_for_project_cli": true,
    "require_lockfile_for_node_install": true,
    "default_network_profile": "none",
    "install_network_profile": "registry_only"
  },
  "docker_image": "python:3.13-slim",
  "docker_network": "bridge",
  "docker_gpus": "none",
  "docker_model_cache_dir": "",
  "use_agent_analyzer": false,
  "agent_timeout_seconds": 900,
  "agent_mode": "off",
  "agent_provider": "deepseek",
  "provider_protocol": "json_action",
  "native_tool_calling": {
    "enabled": false,
    "max_turns": 6,
    "max_calls_per_turn": 1,
    "parallel_calls": false,
    "allow_read_only_tools": true,
    "allow_state_delta_tools": false,
    "allow_side_effect_tools": false,
    "max_tool_result_chars": 12000,
    "tool_result_redaction": true
  },
  "retrieval": {
    "enabled": false,
    "mode": "lexical",
    "fail_closed": false,
    "sources": ["repository", "verified_memory"],
    "lexical_backend": "auto",
    "dense_enabled": false,
    "embedding_provider": "disabled",
    "embedding_model": "",
    "external_embedding_enabled": false,
    "embedding_api_base": "",
    "embedding_api_key_env": "AUTO_HARNESS_RETRIEVAL_EMBEDDING_API_KEY",
    "embedding_dimension": 1536,
    "embedding_timeout_seconds": 30,
    "vector_backend": "exact",
    "reranker": "disabled",
    "default_top_k": 8,
    "max_top_k": 12,
    "lexical_top_n": 30,
    "dense_top_n": 30,
    "fusion_top_n": 20,
    "max_query_chars": 500,
    "max_context_tokens": 3000,
    "max_hit_tokens": 640,
    "max_hits_per_document": 3,
    "max_tool_calls_per_stage": 2,
    "max_repository_chunks": 50000,
    "index_runtime_logs": true,
    "share_unverified_memory": false,
    "tool_result_redaction": true
  },
  "cost_profile": {
    "currency": "USD",
    "pricing_as_of": "2026-08-30",
    "pricing": {
      "deepseek-v4-flash": {
        "input_per_million": 0.28,
        "output_per_million": 0.42,
        "cache_hit_input_per_million": 0.028
      },
      "deepseek-v4-pro": {
        "input_per_million": 0.56,
        "output_per_million": 1.68,
        "cache_hit_input_per_million": 0.056
      }
    }
  },
  "agent_plan_first_provider": "deepseek",
  "agent_repo_context_mode": "eager_compat",
  "agent_repo_inventory_budget_tokens": 4000,
  "agent_repo_core_budget_tokens": 12000,
  "agent_repo_observation_budget_tokens": 50000,
  "agent_repo_max_observation_rounds": 3,
  "agent_repo_max_requests_per_round": 4,
  "agent_repo_max_observed_files": 40,
  "agent_repo_max_chars_per_read": 12000,
  "agent_repo_max_lines_per_read": 400,
  "agent_repo_search_max_results": 30,
  "agent_repo_search_max_files": 5000,
  "agent_repo_search_max_bytes": 50000000,
  "agent_repo_tree_max_entries": 5000,
  "memory_evolution_provider": "deepseek",
  "provider_configs": {
    "deepseek": {
      "api_base": "https://api.deepseek.com",
      "api_key_env": "DEEPSEEK_API_KEY",
      "require_api_key": true,

      "model": "deepseek-v4-flash",
      "context_window_tokens": 262144,
      "max_tokens": 16384,

      "thinking": {
        "agent": "disabled",
        "plan_first": "enabled",
        "memory_evolution": "disabled",
        "llm_test": "disabled",
        "live_smoke": "disabled"
      },

      "reasoning_effort": {
        "plan_first": "high"
      },

      "json_mode": {
        "agent": true,
        "plan_first": true,
        "memory_evolution": true,
        "llm_test": false,
        "live_smoke": true
      },

      "timeout_seconds": 300,
      "max_retries": 2,
      "native_tool_calling": false,
      "native_tool_choice": "auto",
      "native_parallel_tool_calls": false,
      "retry_base_seconds": 1.0,
      "retry_max_seconds": 8.0
    }
  },
  "agent_max_input_chars": 20000,
  "agent_max_file_chars": 6000,
  "agent_context_mode": "enforce",
  "agent_context_window_tokens": 262144,
  "agent_context_reserved_output_tokens": 16384,
  "agent_context_safety_margin_tokens": 2048,
  "agent_context_warn_ratio": 0.7,
  "agent_context_compact_ratio": 0.85,
  "agent_context_tokenizer": "auto",
  "agent_context_unknown_model_fallback_tokens": 8192,
  "agent_context_max_overflow_retries": 1,
  "agent_context_trace_section_details": true,
  "agent_context_skill_budget_tokens": 2000,
  "agent_context_memory_budget_tokens": 2000,
  "agent_decision_timeout_seconds": 300,
  "agent_enable_analyze_planner": false,
  "agent_enable_log_diagnosis": false,
  "agent_enable_verify_planner": false,
  "agent_enable_repair_actions": false,
  "agent_auto_resume_after_repair": false,
  "agent_max_loop_iterations": 2,
  "agent_auto_resume_stages": ["host_preflight", "env_solve", "env_deploy", "model_prepare", "runner", "verify"],
  "agent_stop_on_verify_pass": true,
  "env_backend": "auto",
  "conda_envs_dir": ".conda/envs",
  "conda_prefer_mamba": true,
  "conda_allowed_channels": ["defaults", "conda-forge", "pytorch", "nvidia", "fastai"],
  "conda_python_default": "3.10",
  "torch_cuda_preference": "auto",
  "preflight_enabled": true,
  "preflight_fail_closed": true,
  "preflight_require_gpu": false,
  "gpu_probe_timeout_seconds": 5,
  "conda_probe_timeout_seconds": 10,
  "conda_inventory_timeout_seconds": 30,
  "conda_inventory_max_envs": 50,
  "conda_allow_venv_fallback": false,
  "conda_allow_cpu_fallback": false,
  "conda_reuse_owned_env": true,
  "conda_reuse_external_env": false,
  "min_gpu_memory_mb": 0,
  "skills_dir": "skills",
  "memory_dir": "memory",
  "model_cache_dir": "model_cache",
  "task_queue_dir": "queue",
  "queue_max_concurrent_tasks": 1,
  "queue_gpu_slots": null,
  "queue_claim_ttl_seconds": 3600,
  "model_download_max_workers": 1,
  "model_download_retry_count": 2,
  "model_download_retry_backoff_seconds": 1.0,
  "model_cache_cleanup_max_total_bytes": null,
  "model_cache_cleanup_older_than_days": null,
  "model_cache_cleanup_source": null,
  "model_cache_cleanup_repo_id": null,
  "model_cache_cleanup_keep_cache_keys": [],
  "model_cache_cleanup_keep_repo_ids": [],
  "model_inference_enabled": false,
  "model_runtime": "vllm",
  "model_runtime_mode": "managed_vllm",
  "model_runtime_image": "",
  "model_runtime_require_image_digest": true,
  "model_runtime_port": 8000,
  "model_runtime_dtype": "auto",
  "model_runtime_max_model_len": 4096,
  "model_runtime_max_num_seqs": 1,
  "model_runtime_gpu_memory_utilization": 0.9,
  "model_runtime_tensor_parallel_size": 1,
  "model_runtime_startup_timeout_seconds": 900,
  "model_runtime_request_timeout_seconds": 120,
  "model_runtime_shm_size": "8g",
  "model_runtime_allow_remote_code": false,
  "model_runtime_allow_quantized": false,
  "model_runtime_require_immutable_revision": true,
  "model_runtime_require_strong_weight_integrity": true,
  "model_runtime_disk_safety_ratio": 1.2,
  "model_runtime_ram_safety_ratio": 1.2,
  "max_skill_chars": 6000,
  "max_memory_items": 5,
  "verify_workspace_name": "verify_workspace",
  "allowed_commands": ["python", "python3", "pip", "curl", "git", "streamlit", "conda", "mamba", "micromamba", "uv", "npm"],
  "default_controller": "langgraph",
  "langgraph_require_llm": false,
  "langgraph_planner_mode": "llm",
  "langgraph_allow_mock_in_dry_run": true,
  "langgraph_allow_mock_in_execute": false,
  "langgraph_enable_diagnose": true,
  "langgraph_enable_repair": true,
  "langgraph_enable_agent_verify": true,
  "langgraph_enable_recovery": true,
  "langgraph_fault_injection_points": [],
  "langgraph_max_diagnoses": 2,
  "langgraph_max_repairs": 2,
  "langgraph_max_same_failure": 2,
  "verify": {
    "require_trace_id": true,
    "max_wait_seconds": 300,
    "allow_uncertain": true
  }
}
